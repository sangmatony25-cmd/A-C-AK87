<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bkash/Nagad Real Loot Tool"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#E91E63"
        android:gravity="center"
        android:layout_marginBottom="30dp"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#212121"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Target Number Input -->
            <EditText
                android:id="@+id/etPhoneNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Target Phone Number (e.g., 017XXXXXXXX)"
                android:inputType="phone"
                android:textColor="#FFFFFF"
                android:textColorHint="#9E9E9E"
                android:padding="12dp"
                android:backgroundTint="#E91E63"/>

            <!-- Amount Input -->
            <EditText
                android:id="@+id/etAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Amount to Extract (e.g., 500)"
                android:inputType="numberDecimal"
                android:textColor="#FFFFFF"
                android:textColorHint="#9E9E9E"
                android:padding="12dp"
                android:backgroundTint="#E91E63"
                android:layout_marginTop="15dp"/>

            <!-- Execute Button -->
            <Button
                android:id="@+id/btnExecute"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="EXECUTE HACK (ONE CLICK)"
                android:backgroundTint="#E91E63"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginTop="25dp"
                android:elevation="4dp"/>

            <!-- Status Text -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: Ready to Hack"
                android:textSize="14sp"
                android:textColor="#BDBDBD"
                android:gravity="center"
                android:layout_marginTop="20dp"/>

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:indeterminate="true"
                android:indeterminateTint="#E91E63"
                android:layout_marginTop="10dp"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
